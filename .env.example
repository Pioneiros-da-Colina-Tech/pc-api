# ─── Server ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development  # Application environment: development | production | staging | test
LOG_LEVEL=info           # Logging level: debug | info | warning | error | critical
SERVER_HOST=0.0.0.0      # IP address the server binds to (0.0.0.0 = all interfaces)
SERVER_PORT=8000         # Port the server listens on
WORKERS=5                # Number of worker processes (defaults to cpu_count * 2 + 1)
SENTRY_DSN=              # Sentry DSN for error tracking (leave empty to disable)

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_HOST=                        # PostgreSQL host (e.g. localhost)
DATABASE_PORT=5432                    # PostgreSQL port
DATABASE_USER=                        # PostgreSQL username
DATABASE_PASSWORD=                    # PostgreSQL password
DATABASE_NAME=                        # PostgreSQL database name
DATABASE_ECHO=False                   # Log all SQL statements (True for debugging)
DATABASE_POOL_SIZE=10                 # Persistent connections in the pool
DATABASE_POOL_MAX_OVERFLOW=5          # Extra connections allowed beyond pool size
DATABASE_POOL_RECYCLE=1800            # Seconds before a connection is recycled (30 min)
DATABASE_POOL_PRE_PING=True           # Test connections before use to detect stale ones
DATABASE_POOL_TIMEOUT=30              # Seconds to wait for a connection from the pool
DATABASE_POOL_RESET_ON_RETURN=commit  # Action on connection return: commit | rollback | none

# ─── Auth ─────────────────────────────────────────────────────────────────────
AUTH_SECRET_KEY=                      # Secret key for signing JWT tokens (use a long random string)
AUTH_ALGORITHM=HS256                  # JWT signing algorithm
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30   # JWT expiry in minutes
